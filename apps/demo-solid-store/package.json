{
  "name": "@store-kit/demo-solid-store",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp build",
    "check": "cd ../.. && vp check apps/demo-solid-store",
    "dev": "vp dev",
    "generate-types": "vp exec wrangler types",
    "media:sync": "STORE_KIT_APP=demo-solid-store node --experimental-strip-types ../../packages/tooling/catalog-seed.ts --environment local --only media",
    "media:sync:production": "STORE_KIT_APP=demo-solid-store node --experimental-strip-types ../../packages/tooling/catalog-seed.ts --environment production --only media",
    "migrate:local": "vp exec wrangler d1 migrations apply DB --local",
    "preview": "vp build && vp exec wrangler dev",
    "seed:local": "STORE_KIT_APP=demo-solid-store node --experimental-strip-types ../../packages/tooling/catalog-seed.ts --environment local --only data",
    "test": "node test/run.mjs",
    "typecheck": "vp exec tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/onest": "5.2.8",
    "@solidjs/router": "1.0.0-next.9",
    "@solidjs/web": "2.0.0-beta.26",
    "@store-kit/api": "workspace:*",
    "@store-kit/commerce": "workspace:*",
    "@store-kit/contracts": "workspace:*",
    "solid-js": "2.0.0-beta.26",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@dom-expressions/compiler": "0.50.0-next.29",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.1.1",
    "esbuild": "0.27.0",
    "playwright": "^1.62.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.0.0",
    "vite-plugin-solid": "3.0.0-next.16",
    "vite-plus": "0.2.6",
    "wrangler": "4.113.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
