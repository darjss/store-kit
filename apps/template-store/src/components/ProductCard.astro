---
import type { PublicImage } from '@store-kit/contracts'
import { formatMnt } from '@store-kit/storefront/format'

import ProductImage from './ProductImage.astro'

interface Props {
  product: {
    slug: string
    name: string
    shortDescription?: string | null
    images: (PublicImage & { id: string })[]
    variants: { priceMnt: number; stockQuantity: number; compareAtPriceMnt?: number | null }[]
    category?: { name: string } | null
  }
  index?: number
}

const { product, index = 0 } = Astro.props
const image = product.images[0]
const price = product.variants[0]?.priceMnt ?? 0
const compareAt = product.variants.find(variant => variant.compareAtPriceMnt)?.compareAtPriceMnt
const totalStock = product.variants.reduce((sum, variant) => sum + variant.stockQuantity, 0)
const lowStock = totalStock > 0 && totalStock <= 3
---

<a
  href={`/products/${product.slug}`}
  class="group rise-in block no-underline"
  style={`--reveal-index:${index}`}
>
  <div class="bg-panel border-line overflow-hidden rounded-action border">
    {
      image && (
        <ProductImage
          image={image}
          layout="card"
          class="aspect-[4/5] w-full object-cover transition-transform duration-300 group-hover:scale-[1.02] motion-reduce:transition-none"
        />
      )
    }
  </div>
  <div class="mt-2.5 flex items-start justify-between gap-3">
    <div class="min-w-0">
      <h3 class="text-ink m-0 text-[0.95rem] leading-snug font-bold wrap-break-word">
        {product.name}
      </h3>
      {product.category && <p class="text-muted m-0 mt-0.5 text-xs">{product.category.name}</p>}
    </div>
    <div class="shrink-0 text-right">
      <strong class="font-number text-ink block text-[0.95rem]">{formatMnt(price)}</strong>
      {
        compareAt && compareAt > price ? (
          <s class="text-muted font-number text-xs">{formatMnt(compareAt)}</s>
        ) : null
      }
    </div>
  </div>
  {
    totalStock === 0 ? (
      <p class="text-muted m-0 mt-1 text-xs font-bold">Дууссан</p>
    ) : lowStock ? (
      <p class="text-accent m-0 mt-1 text-xs font-bold">Сүүлийн {totalStock}</p>
    ) : null
  }
</a>
