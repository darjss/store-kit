---
import { commerce } from '@store-kit/commerce'
import { formatMnt } from '@store-kit/storefront/format'
import CutoutPiece from '~/components/moshpit/CutoutPiece.astro'
import TitleStack from '~/components/moshpit/TitleStack.astro'
import Ticker from '~/components/moshpit/Ticker.astro'
import Layout from '~/layouts/Layout.astro'

const result = await commerce.catalog.listProducts({ limit: 24 })
if (result.status === 'error') throw new Error('Catalog could not be loaded.')
const products = result.value.items
const priceOf = (product: (typeof products)[number]) => product.variants[0]?.priceMnt ?? 0

const bySlug = new Map(products.map(product => [product.slug, product]))
const heroSlugs = ['tangzu-waner-2-red-lion', 'kz-prx', 'tanchjim-bunny', 'jcally-jm12']
const heroes = heroSlugs.map(slug => bySlug.get(slug)).filter(product => product !== undefined)
const heroSlugSet = new Set(heroes.map(product => product.slug))
const rest = products.filter(product => !heroSlugSet.has(product.slug))
const minPrice = Math.min(...products.map(priceOf))

const categories = [
  { label: 'IEM', href: '/products?category=in-ear-monitors', note: 'Утастай, тайзны нарийвчлал' },
  { label: 'DAC', href: '/products?category=portable-audio', note: 'Утаснаас цэвэр гаралт' },
  { label: 'ACCESSORIES', href: '/products?category=eartips', note: 'Каталог шинэчлэгдэж байна' },
]

const bobs = ['a', 'b', 'c', 'a'] as const
---

<Layout title="Plugged · Portable audio, Ulaanbaatar" publicPage>
  <style is:global>
    .hero {
      container-type: inline-size;
      height: max(34rem, calc(100dvh - 9.5rem));
    }
    .hero .piece { z-index: var(--z, 12); }

    .hero .piece-tangzu { --x: 48cqw; --y: 8cqh; --w: 39cqw; --z: 12; }
    .hero .piece-prx { --x: 4cqw; --y: 40cqh; --w: 38cqw; --z: 14; }
    .hero .piece-bunny { --x: 54cqw; --y: 42cqh; --w: 36cqw; --z: 15; }
    .hero .piece-jm12 { --x: 12cqw; --y: 68cqh; --w: 19cqw; --z: 16; }
    .hero .piece { position: absolute; left: var(--x); top: var(--y); width: var(--w); }
    .hero-title { position: absolute; left: 3cqw; top: 6cqh; font-size: 24cqw; z-index: 20; }
    .hero-bar { position: absolute; inset-x: 0; bottom: 5.25rem; z-index: 30; }
    .hero-sub { position: absolute; left: 4cqw; top: 34.5cqh; z-index: 18; font-size: 6.5cqw; rotate: -2deg; }
    .hero-kicker { position: absolute; left: 3.5cqw; top: 2.2cqh; z-index: 20; }
    .hero-sticker { position: absolute; left: 5cqw; bottom: 3.2cqh; z-index: 20; rotate: 5deg; }
    .hero-arrow { position: absolute; left: 46cqw; top: 2.5cqh; width: 22cqw; aspect-ratio: 238/164; rotate: -12deg; }
    .hero-star { position: absolute; left: 5cqw; top: 33cqh; width: 13cqw; aspect-ratio: 215/143; animation: spin-slow 14s linear infinite; }
    .hero-anno { position: absolute; left: 48cqw; top: 26cqh; rotate: -5deg; z-index: 22; }

    @media (min-width: 1024px) {
      .hero-title { left: 3cqw; top: 16cqh; font-size: 16.5cqw; }
      .hero-sub { left: 4cqw; top: 29cqh; font-size: 1.6cqw; rotate: 0deg; }
      .hero-kicker { left: 3.6cqw; top: 12cqh; }
      .hero-sticker { left: auto; right: 8cqw; bottom: 12cqh; rotate: -6deg; }
      .hero-bar { bottom: 0; }
      .hero .piece-tangzu { --x: 62cqw; --y: 5cqh; --w: 21cqw; }
      .hero .piece-prx { --x: 14cqw; --y: 46cqh; --w: 21cqw; }
      .hero .piece-bunny { --x: 70cqw; --y: 40cqh; --w: 19cqw; }
      .hero .piece-jm12 { --x: 55cqw; --y: 64cqh; --w: 11cqw; }
      .hero-arrow { left: 58cqw; top: 9cqh; width: 10cqw; }
      .hero-star { left: 50cqw; top: 7cqh; width: 5.5cqw; }
      .hero-anno { left: 57cqw; top: 34cqh; }
    }
    @media (min-width: 1280px) {
      .hero-title, .hero-sub, .hero-kicker { left: 8cqw; }
    }
  </style>

  <main id="main-content" tabindex="-1" class="bg-ink text-paper xl:ml-36">
    <section class="hero relative overflow-clip border-b border-paper/15" aria-labelledby="stack">
      <img class="pointer-events-none absolute inset-0 h-full w-full object-cover object-[30%_40%] opacity-50" src="/moshpit/backdrop.jpg" alt="" aria-hidden="true" />
      <div class="strobe-bar absolute inset-x-0 top-0 z-30" aria-hidden="true"></div>

      <p class="hero-kicker m-0 inline-block bg-ink/45 px-2 py-1 font-mono text-[0.6rem] font-bold tracking-[0.42em] text-paper/80 uppercase">Утастай сонсгол — Улаанбаатар</p>
      <TitleStack text="СОНС." class="hero-title" id="stack" />
      <p class="hero-sub m-0 font-body font-black text-signal [-webkit-text-stroke:1.5px_rgb(0_0_0/0.55)] uppercase">Утастай сонсгол.</p>

      {heroes.map((product, index) => (
        <CutoutPiece
          slug={product.slug}
          name={product.name}
          price={formatMnt(priceOf(product))}
          class={`piece-${product.slug === 'tangzu-waner-2-red-lion' ? 'tangzu' : product.slug === 'jcally-jm12' ? 'jm12' : product.slug === 'kz-prx' ? 'prx' : 'bunny'}`}
          bob={bobs[index % bobs.length]}
          priority={index === 0}
          depth={1.4 + index * 0.4}
        />
      ))}

      <div class="hero-arrow pointer-events-none z-18 bg-[url('/moshpit/stroke-arrow.webp')] bg-contain bg-center bg-no-repeat mix-blend-screen" aria-hidden="true"></div>
      <div class="hero-star pointer-events-none z-18 bg-[url('/moshpit/stroke-star.webp')] bg-contain bg-center bg-no-repeat mix-blend-screen" aria-hidden="true"></div>
      <span class="hero-anno jitter m-0 font-mono text-[0.62rem] font-extrabold tracking-[0.14em] text-paper uppercase [text-shadow:0_1px_0_var(--color-ink)]">бодит кабель ↘</span>

      <div class="hero-sticker border-2 border-ink bg-signal px-4 py-2 font-body text-lg font-black tabular-nums text-ink shadow-[0.25rem_0.3rem_0_rgb(0_0_0/0.65)]">
        {formatMnt(minPrice)}-С ЭХЭЛНЭ
      </div>

      <div class="pointer-events-none absolute inset-0 z-25 grain-flick" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-0 z-26 scanlines" aria-hidden="true"></div>
      <div data-bloom class="pointer-events-none absolute inset-0 z-40 bg-white" aria-hidden="true"></div>

      <div class="hero-bar flex h-14 items-stretch border-t-[3px] border-paper/25 bg-ink/88 backdrop-blur-sm">
        <a href="/products" class="pressable flex shrink-0 items-center bg-signal px-6 font-body text-lg font-black text-ink no-underline">БҮХ БАРАА →</a>
        <Ticker text={products.map(product => product.name).join(' · ') + ' · УТАСТАЙ СОНСГОЛ · УЛААНБААТАР · '} class="grid min-w-0 flex-1 content-center text-[0.68rem] font-bold text-paper/75" />
      </div>
    </section>

    {rest.length > 0 && (
      <section class="border-b border-paper/15 py-[clamp(3rem,7vw,7rem)]" aria-labelledby="next-rail">
        <div class="mx-auto max-w-[86rem] px-gutter">
          <h2 id="next-rail" class="font-body text-[clamp(2.5rem,6vw,5rem)] leading-[0.9] font-black tracking-[-0.03em]">ДАРААГИЙН <span class="text-signal">СОНСГОЛ</span></h2>
          <div class="mt-10 grid gap-10 md:grid-cols-2">
            {rest.map((product, index) => {
              return (
                <a
                  href={`/products/${product.slug}`}
                  class="group grid grid-cols-[7rem_minmax(0,1fr)] items-center gap-5 border-b border-paper/15 pb-8 no-underline"
                >
                  <img
                    class={`moshpit-cut w-full transition-transform duration-300 [transition-timing-function:var(--ease-slam)] group-hover:scale-[1.06] group-hover:-rotate-2 ${index % 2 ? 'bob-b' : 'bob-c'}`}
                    src={`/cut/${product.slug}.webp`}
                    alt={product.name}
                    width="1400"
                    height="1260"
                    loading="lazy"
                    decoding="async"
                  />
                  <span>
                    <span class="m-0 block font-mono text-[0.7rem] font-extrabold tracking-[0.3em] text-acid uppercase">{product.brand?.name ?? 'PLUGGED'} / 0{index + 1}</span>
                    <span class="mt-1 block font-body text-[clamp(1.6rem,3.4vw,2.6rem)] leading-[0.95] font-black tracking-[-0.03em] text-paper group-hover:text-signal">{product.name}</span>
                    <span class="mt-2 block max-w-120 text-sm text-paper/70 max-md:line-clamp-2">{product.shortDescription}</span>
                    <span class="mt-3 flex items-center gap-4">
                      <strong class="chip-price text-sm group-hover:rotate-0">{formatMnt(priceOf(product))}</strong>
                      <span class="font-black text-signal">СОНГОХ →</span>
                    </span>
                  </span>
                </a>
              )
            })}
          </div>
        </div>
      </section>
    )}

    <section class="grid grid-cols-3 max-md:grid-cols-1" aria-label="Барааны ангилал">
      {categories.map((category, index) => (
        <a class="pressable group flex min-h-60 flex-col justify-between border-r border-paper/15 p-5 no-underline text-paper hover:bg-petrol max-md:min-h-40 max-md:border-r-0 max-md:border-b max-md:last:border-b-0" href={category.href}>
          <span class="font-display text-[clamp(2.5rem,6vw,5.5rem)] leading-[0.85] font-black tracking-[-0.03em] group-hover:text-signal">{category.label}</span>
          <span class="flex items-end justify-between gap-4"><strong class="max-w-60">{category.note}</strong><b class="text-3xl text-signal">0{index + 1} ↗</b></span>
        </a>
      ))}
    </section>
  </main>
  <script>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelector('[data-bloom]')?.animate(
        [{ opacity: 1 }, { opacity: 0.15, offset: 0.1 }, { opacity: 0.9, offset: 0.18 }, { opacity: 0 }],
        { duration: 520, easing: 'steps(4, end)', fill: 'forwards' },
      )
      const layers = [...document.querySelectorAll('[data-depth]')]
      let raf = 0
      const parallax = (x: number, y: number) => {
        const nx = x / innerWidth - 0.5
        const ny = y / innerHeight - 0.5
        for (const el of layers) {
          if (!(el instanceof HTMLElement)) continue
          const depth = Number(el.dataset.depth ?? 1)
          el.style.translate = `${nx * depth * -7}px ${ny * depth * -5}px`
        }
        raf = 0
      }
      addEventListener('pointermove', event => {
        if (!raf) raf = requestAnimationFrame(() => parallax(event.clientX, event.clientY))
      }, { passive: true })
    } else {
      (document.querySelector('[data-bloom]') as HTMLElement | null)?.style.setProperty('opacity', '0')
    }
  </script>
</Layout>
