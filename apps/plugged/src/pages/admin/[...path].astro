---
import { AdminShell } from '@store-kit/admin'
import '@store-kit/admin/styles.css'

Astro.response.headers.set('Cache-Control', 'private, no-store')
---

<!doctype html>
<html lang="en" class="bg-background font-sans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ffffff" />
    <title>Store Kit Admin</title>
  </head>
  <body class="m-0 min-w-0 bg-background text-foreground antialiased">
    <AdminShell client:only="solid-js" />
  </body>
</html>
