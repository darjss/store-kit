---
import { commerce } from "@store-kit/commerce";
import type { ProductListFilters } from "@store-kit/db/schemas";
import { formatMnt } from "@store-kit/storefront/format";
import { cn } from "@store-kit/ui/utils";
import { catalogHref } from "~/catalog-links";
import TitleStack from "~/components/moshpit/TitleStack.astro";
import Layout from "~/layouts/Layout.astro";

const params = Astro.url.searchParams;
const validUseCases = ["first-iem", "bass", "vocals", "gaming", "daily-carry"] as const;
const useCaseValue = params.get("useCase");
const filters: ProductListFilters = {
  ...(params.get("category") ? { category: params.get("category")! } : {}),
  ...(params.get("brand") ? { brand: params.get("brand")! } : {}),
  ...(validUseCases.includes(useCaseValue as (typeof validUseCases)[number]) ? { useCase: useCaseValue as (typeof validUseCases)[number] } : {}),
  ...(params.get("query")?.trim() ? { query: params.get("query")!.trim() } : {}),
  limit: 50,
};
const [result, categories, brands] = await Promise.all([
  commerce.catalog.listProducts(filters),
  commerce.catalog.listCategories(),
  commerce.catalog.listBrands(),
]);
if (result.status === "error") throw new Error("Catalog could not be loaded.");

const productOrder = new Map([
  ["tangzu-waner-2-red-lion", 0],
  ["kz-prx", 1],
  ["tanchjim-bunny", 2],
  ["truthear-gate", 3],
  ["truthear-keyx", 4],
  ["jcally-jm12", 5],
]);
const products = [...result.value.items].toSorted((a, b) => (productOrder.get(a.slug) ?? 99) - (productOrder.get(b.slug) ?? 99));
const useCaseLabels = { "first-iem": "АНХНЫ IEM", bass: "BASS", vocals: "VOCALS", gaming: "GAMING", "daily-carry": "DAILY CARRY" };
const activeFilters = [
  filters.category && { label: categories.find(item => item.slug === filters.category)?.name ?? filters.category, href: catalogHref(params, { category: undefined }) },
  filters.brand && { label: brands.find(item => item.slug === filters.brand)?.name ?? filters.brand, href: catalogHref(params, { brand: undefined }) },
  filters.query && { label: `“${filters.query}”`, href: catalogHref(params, { query: undefined }) },
  filters.useCase && { label: useCaseLabels[filters.useCase], href: catalogHref(params, { useCase: undefined }) },
].filter(Boolean) as { label: string; href: string }[];
---

<Layout title="Бүх бараа · Plugged" description="IEM болон portable DAC сонгох." publicPage>
  <style>
    .catalog-cut-faint {
      filter:
        brightness(1.35)
        contrast(1.08)
        drop-shadow(7px 9px 12px rgb(227 87 30 / 0.48))
        drop-shadow(-7px -5px 14px rgb(19 84 183 / 0.44))
        drop-shadow(0 0 10px rgb(244 240 230 / 0.32))
        drop-shadow(6px 10px 9px rgb(0 0 0 / 0.8));
    }
    @media (min-width: 1024px) {
      .catalog-cut-faint { filter: brightness(1.08) contrast(1.04) drop-shadow(7px 9px 12px rgb(227 87 30 / 0.4)) drop-shadow(-7px -5px 14px rgb(19 84 183 / 0.36)) drop-shadow(6px 10px 9px rgb(0 0 0 / 0.8)); }
    }
  </style>
  <main id="main-content" tabindex="-1" class="min-h-screen bg-ink pb-24 text-paper xl:ml-36">
    <header class="relative overflow-hidden border-b border-paper/15 px-gutter py-[clamp(1.25rem,3vw,2.5rem)]">
      <div class="strobe-bar absolute inset-x-0 top-0" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-0 grain-flick opacity-20" aria-hidden="true"></div>
      <div class="relative mx-auto grid max-w-[82rem] items-end gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(25rem,38rem)] lg:gap-10">
        <div>
          <TitleStack text="БҮХ БАРАА" class="text-[clamp(2.65rem,6vw,5rem)]" />
          <p class="mt-3 mb-0 font-mono text-[0.68rem] font-extrabold tracking-[0.28em] uppercase">PLUGGED CATALOG <span class="text-signal">/</span> {products.length} БАРАА</p>
        </div>
        <form action="/products" method="get" role="search" class="grid grid-cols-[minmax(0,1fr)_auto]">
          {filters.category && <input type="hidden" name="category" value={filters.category} />}
          {filters.brand && <input type="hidden" name="brand" value={filters.brand} />}
          {filters.useCase && <input type="hidden" name="useCase" value={filters.useCase} />}
          <label class="sr-only" for="catalog-search">БАРАА ХАЙХ</label>
          <input class="min-h-13 min-w-0 rounded-none border-2 border-paper/30 bg-paper-clean px-4 text-base font-extrabold text-ink placeholder:text-ink/75 focus-visible:outline-offset-[-4px]" id="catalog-search" name="query" value={filters.query ?? ""} placeholder="IEM, DAC, брэнд…" />
          <button class="pressable min-h-13 border-2 border-signal bg-signal px-5 font-black text-ink" type="submit">ХАЙ →</button>
        </form>
      </div>
    </header>

    <section class="border-b border-paper/15 bg-petrol/55 px-gutter py-3" aria-label="Каталогийн шүүлтүүр">
      <div class="mx-auto max-w-[82rem]">
        <div class="flex items-center gap-3 max-lg:flex-col max-lg:items-stretch">
          <div class="relative min-w-0 flex-1">
            <nav class="flex snap-x gap-1 overflow-x-auto pr-16 [scrollbar-width:none]" aria-label="Хэрэглээгээр шүүх">
              <a class={cn("pressable min-h-11 shrink-0 snap-start px-4 py-2.5 text-sm font-black no-underline", !filters.useCase ? "bg-signal text-ink" : "text-paper/75 hover:text-paper")} href={catalogHref(params, { useCase: undefined })} aria-current={!filters.useCase ? "page" : undefined}>БҮГД</a>
              {validUseCases.map(slug => <a class={cn("pressable min-h-11 shrink-0 snap-start px-4 py-2.5 text-sm font-black text-paper/75 no-underline hover:text-paper", filters.useCase === slug && "bg-signal text-ink")} href={catalogHref(params, { useCase: slug })} aria-current={filters.useCase === slug ? "page" : undefined}>{useCaseLabels[slug]}</a>)}
            </nav>
            <span class="pointer-events-none absolute inset-y-0 right-0 grid place-items-center bg-petrol/95 px-2 font-mono text-[0.6rem] font-black tracking-[0.12em] text-acid lg:hidden" aria-hidden="true">SCROLL →</span>
          </div>

          <details class="relative shrink-0 border border-signal/60 bg-ink" open={Boolean(filters.category || filters.brand)}>
            <summary class="pressable flex min-h-11 cursor-pointer items-center justify-between gap-8 px-4 text-sm font-black">ТӨРӨЛ / БРЭНД <span class="text-xl text-signal" aria-hidden="true">＋</span></summary>
            <div class="grid gap-4 border-t border-paper/20 p-4 lg:absolute lg:right-gutter lg:z-20 lg:mt-px lg:w-[min(44rem,calc(100vw-2*var(--spacing-gutter)))] lg:grid-cols-2 lg:bg-petrol lg:shadow-[0_10px_0_rgb(0_0_0/0.65)]">
              <div><strong class="block text-signal">ТӨРӨЛ</strong><div class="mt-2 flex flex-wrap gap-2"><a class="filter-chip no-underline" href={catalogHref(params, { category: undefined })}>БҮХ ТӨРӨЛ</a>{categories.map(category => <a class={cn("filter-chip no-underline", filters.category === category.slug && "filter-chip-active")} href={catalogHref(params, { category: category.slug })} aria-current={filters.category === category.slug ? "page" : undefined}>{category.slug === "eartips" ? "ACCESSORIES" : category.name}</a>)}</div></div>
              <div><strong class="block text-signal">БРЭНД</strong><div class="mt-2 flex flex-wrap gap-2"><a class="filter-chip no-underline" href={catalogHref(params, { brand: undefined })}>БҮХ БРЭНД</a>{brands.map(brand => <a class={cn("filter-chip no-underline", filters.brand === brand.slug && "filter-chip-active")} href={catalogHref(params, { brand: brand.slug })} aria-current={filters.brand === brand.slug ? "page" : undefined}>{brand.name}</a>)}</div></div>
            </div>
          </details>
        </div>

        {activeFilters.length > 0 && <div class="mt-3 flex flex-wrap items-center gap-2"><span class="text-sm font-bold">ИДЭВХТЭЙ:</span>{activeFilters.map(filter => <a class="border border-signal px-3 py-1 text-sm font-bold text-paper no-underline" href={filter.href}>{filter.label} ×</a>)}<a class="ml-auto text-sm font-black text-signal" href="/products">ЦЭВЭРЛЭХ</a></div>}
      </div>
    </section>

    {products.length === 0 ? (
      <section class="mx-auto grid min-h-[50svh] max-w-[50rem] place-content-center px-gutter text-center">
        <p class="text-signal">0 ҮР ДҮН</p>
        <h2 class="m-0 font-body text-[clamp(2.6rem,8vw,5rem)] leading-[0.9] font-black text-balance">ЭНЭ ШҮҮЛТҮҮРТ БАРАА АЛГА.</h2>
        <p>Хайлтаа богиносгох эсвэл нэг шүүлтүүрийг арилгана уу.</p>
        <a class="pressable mx-auto mt-4 border-2 border-signal px-5 py-3 font-black text-paper no-underline" href="/products">БҮХ БАРАА ХАРАХ →</a>
      </section>
    ) : (
      <section class="mx-auto grid max-w-[82rem] gap-x-[clamp(2rem,5vw,6rem)] gap-y-8 px-gutter py-6 lg:grid-cols-2 lg:gap-y-14 lg:py-10" aria-label="Барааны жагсаалт">
        {products.map((product, index) => {
          const variant = product.variants[0];
          const stock = product.variants.reduce((sum, item) => sum + item.stockQuantity, 0);
          const needsFlash = product.slug === "tanchjim-bunny" || product.slug === "truthear-gate";
          return (
            <article data-catalog-product style={`--reveal-index:${Math.min(index, 8)}`} class={cn("group relative isolate grid min-h-[21rem] grid-rows-[11.5rem_auto] overflow-hidden border-b border-paper/20 lg:min-h-[31rem] lg:grid-rows-[19rem_auto]", index % 2 === 1 && "lg:translate-y-8")}>
              <a class="relative grid place-items-center overflow-visible" href={`/products/${product.slug}`} tabindex="-1" aria-hidden="true">
                <span class={cn("pointer-events-none absolute inset-[8%] bg-[radial-gradient(circle_at_42%_50%,rgb(244_240_230/0.17)_0%,rgb(19_84_183/0.16)_34%,rgb(227_87_30/0.12)_52%,transparent_72%)] blur-xl transition-transform duration-300 group-hover:scale-110", needsFlash && "bg-[radial-gradient(circle_at_42%_50%,rgb(244_240_230/0.34)_0%,rgb(19_84_183/0.22)_36%,rgb(227_87_30/0.17)_56%,transparent_76%)]")} aria-hidden="true"></span>
                <img class={`moshpit-cut relative h-full max-h-[18rem] w-full object-contain p-3 transition-transform duration-300 [transition-timing-function:var(--ease-slam)] group-hover:scale-[1.06] ${needsFlash ? "catalog-cut-faint scale-[1.22] lg:scale-100" : ""} ${index % 3 === 0 ? "-rotate-2" : index % 3 === 1 ? "rotate-2" : "-rotate-1"}`} src={`/cut/${product.slug}.webp`} alt="" width="1400" height="1260" loading="eager" decoding="async" />
              </a>

              <div class="relative flex min-w-0 flex-col justify-end pb-5">
                <p class="m-0 font-mono text-[0.66rem] font-extrabold tracking-[0.24em] text-acid uppercase">{product.brand?.name ?? "PLUGGED"} / 0{index + 1}</p>
                <h2 class="my-1 font-body text-[clamp(1.65rem,3vw,2.7rem)] leading-[0.95] font-black tracking-[-0.03em] text-balance"><a class="no-underline transition-colors group-hover:text-signal" href={`/products/${product.slug}`}>{product.name}</a></h2>
                <p class="mt-1 mb-4 line-clamp-2 max-w-[54ch] text-sm text-paper/65">{product.shortDescription}</p>

                <div class="flex flex-wrap items-stretch gap-2">
                  <strong class="grid min-h-12 place-items-center bg-signal px-4 text-[clamp(1rem,2vw,1.35rem)] leading-none font-black tabular-nums text-ink">{variant ? formatMnt(variant.priceMnt) : "—"}</strong>
                  <span class={cn("grid min-h-12 place-items-center border border-paper/25 px-3 font-mono text-[0.66rem] font-extrabold tracking-[0.14em]", stock === 0 ? "text-warning" : "text-paper/70")}>{stock === 0 ? "ДУУССАН" : stock <= 3 ? "ЦӨӨН" : "БЭЛЭН"}</span>
                  <a class="pressable ml-auto grid min-h-12 place-items-center border-2 border-signal px-4 font-black text-paper no-underline transition-colors hover:bg-signal hover:text-ink" href={`/products/${product.slug}`}>СОНГОХ →</a>
                </div>
              </div>
            </article>
          );
        })}
      </section>
    )}
  </main>
</Layout>
