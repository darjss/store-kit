---
import { commerce } from "@store-kit/commerce";
import type { ProductListFilters } from "@store-kit/db/schemas";
import { formatMnt } from "@store-kit/storefront/format";
import { cn } from "@store-kit/ui/utils";
import { catalogHref } from "~/catalog-links";
import TitleStack from "~/components/moshpit/TitleStack.astro";
import Layout from "~/layouts/Layout.astro";

const params = Astro.url.searchParams;
const validUseCases = ["first-iem", "bass", "vocals", "gaming", "daily-carry"] as const;
const useCaseValue = params.get("useCase");
const filters: ProductListFilters = {
  ...(params.get("category") ? { category: params.get("category")! } : {}),
  ...(params.get("brand") ? { brand: params.get("brand")! } : {}),
  ...(validUseCases.includes(useCaseValue as (typeof validUseCases)[number]) ? { useCase: useCaseValue as (typeof validUseCases)[number] } : {}),
  ...(params.get("query")?.trim() ? { query: params.get("query")!.trim() } : {}),
  limit: 50,
};
const [result, categories, brands] = await Promise.all([
  commerce.catalog.listProducts(filters),
  commerce.catalog.listCategories(),
  commerce.catalog.listBrands(),
]);
if (result.status === "error") throw new Error("Catalog could not be loaded.");
const products = result.value.items;
const useCaseLabels = { "first-iem": "АНХНЫ IEM", bass: "BASS", vocals: "VOCALS", gaming: "GAMING", "daily-carry": "DAILY CARRY" };
const activeFilters = [
  filters.category && { label: categories.find(item => item.slug === filters.category)?.name ?? filters.category, href: catalogHref(params, { category: undefined }) },
  filters.brand && { label: brands.find(item => item.slug === filters.brand)?.name ?? filters.brand, href: catalogHref(params, { brand: undefined }) },
  filters.query && { label: `“${filters.query}”`, href: catalogHref(params, { query: undefined }) },
  filters.useCase && { label: useCaseLabels[filters.useCase], href: catalogHref(params, { useCase: undefined }) },
].filter(Boolean) as { label: string; href: string }[];
---

<Layout title="Бүх бараа · Plugged" description="IEM болон portable DAC сонгох." publicPage>
  <main id="main-content" tabindex="-1" class="min-h-screen bg-ink pb-24 text-paper xl:ml-36">
    <header class="relative overflow-hidden border-b border-paper/15 px-gutter py-[clamp(2rem,5vw,4.5rem)]">
      <div class="strobe-bar absolute inset-x-0 top-0" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-0 grain-flick opacity-25" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-[82rem]">
        <TitleStack text="БҮХ БАРАА" class="text-[clamp(3.1rem,8vw,6rem)]" />
        <p class="mt-5 mb-3 font-extrabold">PLUGGED CATALOG <span class="text-signal">/</span> {products.length} БАРАА</p>
        <form action="/products" method="get" role="search" class="grid grid-cols-[auto_minmax(0,1fr)_auto] max-sm:grid-cols-[1fr_auto]">
          {filters.category && <input type="hidden" name="category" value={filters.category} />}
          {filters.brand && <input type="hidden" name="brand" value={filters.brand} />}
          {filters.useCase && <input type="hidden" name="useCase" value={filters.useCase} />}
          <label class="grid min-h-15 place-items-center border-y-2 border-l-2 border-paper/25 px-5 font-black max-sm:sr-only" for="catalog-search">БАРАА ХАЙХ</label>
          <input class="min-h-15 min-w-0 rounded-none border-y-2 border-paper/25 bg-paper-clean px-5 text-lg font-extrabold text-ink placeholder:text-ink/70 focus-visible:outline-offset-[-4px]" id="catalog-search" name="query" value={filters.query ?? ""} placeholder="IEM, DAC, брэнд…" />
          <button class="pressable min-h-15 border-y-2 border-r-2 border-signal bg-signal px-7 font-black text-ink" type="submit">ХАЙ →</button>
        </form>
      </div>
    </header>

    <section class="mx-auto max-w-[82rem] px-gutter py-4" aria-label="Каталогийн шүүлтүүр">
      <nav class="flex snap-x gap-px overflow-x-auto bg-petrol p-1 [scrollbar-width:none] [mask-image:linear-gradient(90deg,black_0%,black_calc(100%-3.5rem),rgb(0_0_0/0.25))]" aria-label="Хэрэглээгээр шүүх">
        <a class={cn("pressable min-h-12 shrink-0 snap-start px-5 py-3 font-black no-underline", !filters.useCase ? "bg-ink text-signal shadow-[inset_0_-3px_0_var(--color-signal)]" : "text-paper/80")} href={catalogHref(params, { useCase: undefined })} aria-current={!filters.useCase ? "page" : undefined}>БҮГД</a>
        {validUseCases.map(slug => <a class={cn("pressable min-h-12 shrink-0 snap-start px-5 py-3 font-black text-paper/80 no-underline", filters.useCase === slug && "bg-ink text-signal shadow-[inset_0_-3px_0_var(--color-signal)]")} href={catalogHref(params, { useCase: slug })} aria-current={filters.useCase === slug ? "page" : undefined}>{useCaseLabels[slug]}</a>)}
      </nav>

      <details class="mt-3 border-2 border-signal/70 bg-petrol" open={Boolean(filters.category || filters.brand)}>
        <summary class="pressable flex min-h-12 cursor-pointer items-center justify-between px-4 font-black">ТӨРӨЛ / БРЭНДЭЭР ШҮҮХ <span class="text-2xl text-signal" aria-hidden="true">＋</span></summary>
        <div class="grid gap-4 border-t border-paper/30 p-4 md:grid-cols-2">
          <div><strong class="block text-signal">ТӨРӨЛ</strong><div class="mt-2 flex flex-wrap gap-2"><a class="filter-chip no-underline" href={catalogHref(params, { category: undefined })}>БҮХ ТӨРӨЛ</a>{categories.map(category => <a class={cn("filter-chip no-underline", filters.category === category.slug && "filter-chip-active")} href={catalogHref(params, { category: category.slug })} aria-current={filters.category === category.slug ? "page" : undefined}>{category.slug === "eartips" ? "ACCESSORIES" : category.name}</a>)}</div></div>
          <div><strong class="block text-signal">БРЭНД</strong><div class="mt-2 flex flex-wrap gap-2"><a class="filter-chip no-underline" href={catalogHref(params, { brand: undefined })}>БҮХ БРЭНД</a>{brands.map(brand => <a class={cn("filter-chip no-underline", filters.brand === brand.slug && "filter-chip-active")} href={catalogHref(params, { brand: brand.slug })} aria-current={filters.brand === brand.slug ? "page" : undefined}>{brand.name}</a>)}</div></div>
        </div>
      </details>

      {activeFilters.length > 0 && <div class="mt-3 flex flex-wrap items-center gap-2"><span class="font-bold">ИДЭВХТЭЙ:</span>{activeFilters.map(filter => <a class="border border-signal px-3 py-1 font-bold text-paper no-underline" href={filter.href}>{filter.label} ×</a>)}<a class="ml-auto font-black text-signal" href="/products">ЦЭВЭРЛЭХ</a></div>}
    </section>

    {products.length === 0 ? <section class="mx-auto grid min-h-[50svh] max-w-[50rem] place-content-center px-gutter text-center"><p class="text-signal">0 ҮР ДҮН</p><h2 class="m-0 font-body text-[clamp(2.6rem,8vw,5rem)] leading-[0.9] font-black text-balance">ЭНЭ ШҮҮЛТҮҮРТ БАРАА АЛГА.</h2><p>Хайлтаа богиносгох эсвэл нэг шүүлтүүрийг арилгана уу.</p><a class="pressable mx-auto mt-4 border-2 border-signal px-5 py-3 font-black text-paper no-underline" href="/products">БҮХ БАРАА ХАРАХ →</a></section> : <section class="mx-auto grid max-w-[82rem] gap-5 px-gutter py-6" aria-label="Барааны жагсаалт">
      {products.map((product, index) => {
        const variant = product.variants[0];
        const stock = product.variants.reduce((sum, item) => sum + item.stockQuantity, 0);
        return <article data-catalog-product style={`--reveal-index:${Math.min(index, 8)}`} class={cn("group relative grid grid-cols-[minmax(9rem,0.7fr)_minmax(0,1.6fr)] items-center gap-[clamp(0.75rem,2.5vw,2.5rem)] border-b border-paper/15 pb-5 max-md:grid-cols-[minmax(6rem,0.5fr)_minmax(0,1fr)]", index % 2 === 1 && "md:ml-[6%]", index % 3 === 2 && "md:mr-[4%]")}>
          <a class="relative block py-4" href={`/products/${product.slug}`} tabindex="-1" aria-hidden="true">
            <img class={`moshpit-cut w-full transition-transform duration-300 [transition-timing-function:var(--ease-slam)] group-hover:scale-[1.05] group-hover:rotate-2 ${index % 3 === 0 ? "bob-a" : index % 3 === 1 ? "bob-b" : "bob-c"}`} src={`/cut/${product.slug}.webp`} alt="" width="1400" height="1260" loading={index < 4 ? "eager" : "lazy"} decoding="async" />
          </a>
          <div class="relative grid grid-cols-[minmax(0,1fr)_auto] items-center gap-4 max-md:block">
            <div class="min-w-0">
              <p class="m-0 font-mono text-[0.7rem] font-extrabold tracking-[0.3em] text-acid uppercase">{product.brand?.name ?? "PLUGGED"} / 0{index + 1}</p>
              <h2 class="my-1 font-body text-[clamp(1.6rem,3vw,2.6rem)] leading-[0.95] font-black tracking-[-0.03em] text-balance"><a class="no-underline transition-colors group-hover:text-signal" href={`/products/${product.slug}`}>{product.name}</a></h2>
              <p class="m-0 line-clamp-2 text-paper/70 max-md:hidden">{product.shortDescription}</p>
            </div>
            <div class="mt-2 flex items-center gap-5 max-md:flex-wrap max-md:gap-3 max-md:justify-between">
              <strong class="chip-price text-[clamp(1.05rem,2.2vw,1.5rem)] group-hover:rotate-0">{variant ? formatMnt(variant.priceMnt) : "—"}</strong>
              <span class={cn("font-mono text-[0.7rem] font-extrabold tracking-[0.2em]", stock === 0 && "text-warning")}>{stock === 0 ? "ДУУССАН" : stock <= 3 ? "ЦӨӨН" : "БЭЛЭН"}</span>
              <a class="pressable min-h-12 border-2 border-signal px-4 py-3 font-black text-paper no-underline transition-colors hover:bg-signal hover:text-ink" href={`/products/${product.slug}`}>СОНГОХ →</a>
            </div>
          </div>
        </article>;
      })}
    </section>}
  </main>
</Layout>
